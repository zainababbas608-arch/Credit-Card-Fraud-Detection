# ---- Data (too large for GitHub; raw CSVs ~1.3 GB, 100 MB file limit) ----
data/*.csv
data/*.zip

# Keep folder structure in the repo
!data/.gitkeep
!data/README.md

# ---- Processed / derived artifacts ----
data/processed/
*.parquet

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- Spark job logs / outputs ----
logs/
spark-warehouse/
derby.log
metastore_db/

# ---- Dashboard / misc ----
.env
.DS_Store
Thumbs.db
docker_run_steps

# ---- Reports (keep, but ignore temp exports) ----
reports/~$*
